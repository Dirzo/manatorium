{
  "name": "siege-of-legends",
  "version": "0.22.0",
  "private": true,
  "description": "Browser castle-defense auto battler, bundled into one HTML file.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "deploy": "npx wrangler deploy",
    "deploy:worker": "node build.mjs && node tools/deploy-worker.mjs --upload",
    "boss-odds": "node tools/boss-odds.mjs",
    "item-scaling": "node tools/item-scaling.mjs",
    "build:app": "node build.mjs && node tools/build-app.mjs && npx cap sync",
    "android": "npm run build:app && npx cap open android",
    "ios": "npm run build:app && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@revenuecat/purchases-capacitor": "^13.7.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "esbuild": "^0.25.12"
  }
}
